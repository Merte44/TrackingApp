# Supabase — copy this file to `.env.local` and fill in your project's values.
# Dashboard → Project Settings → API.
#
# Only EXPO_PUBLIC_*-prefixed vars are available in the app bundle — and they end
# up in the shipped binary, so treat them as PUBLIC. The anon key is meant to be
# public (Row Level Security is the real authorization layer). NEVER put the
# service-role key here — it belongs only in Supabase Edge Functions.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
